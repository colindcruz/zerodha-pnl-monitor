# Reverse proxy for the live dashboard — gets a real Let's Encrypt certificate for
# free with no domain purchase, by using nip.io's wildcard DNS-to-IP service as the
# hostname. 157-245-102-152.nip.io resolves to 157.245.102.152 with zero DNS setup;
# Caddy requests and renews the cert automatically via the HTTP-01 challenge, which
# needs port 80 reachable in addition to 443 (used only for the ACME handshake and to
# redirect stray HTTP traffic — Caddy does this redirect itself, nothing to add here).
#
# If the droplet's IP ever changes, update the hostname below to match (and revisit
# the DASHBOARD_PASSWORD / session secret — a new IP with the old nip.io host pointing
# nowhere is a good moment to rotate them anyway).
157-245-102-152.nip.io {
	reverse_proxy 127.0.0.1:8765
}

# NIFTY decision dashboard — a second, independent site block on a nip.io
# SUBDOMAIN (nip.io supports arbitrary labels before the IP-encoded part, so
# this needs no new DNS setup) rather than a path prefix on the block above.
# live-dashboard's own HTML/JS use root-absolute URLs (fetch("/api/..."),
# action="/login"), which a path-stripping reverse proxy would break; a
# separate hostname/site block sidesteps that entirely and gets its own
# independently-renewed Let's Encrypt cert via SNI for free.
nifty.157-245-102-152.nip.io {
	reverse_proxy 127.0.0.1:8766
}

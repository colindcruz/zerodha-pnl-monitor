# live-dashboard/server.py reads its own .env (place a real one at
# live-dashboard/.env — python-dotenv loads it from the working directory).

# Same Kite app credentials as the main bot's .env — only the API key is needed here
# (this process reads the access token from ACCESS_TOKEN_PATH below, it doesn't do
# its own login).
KITE_API_KEY=your_api_key_here

# Path to the SAME .access_token file the trading bot writes (default assumes this
# directory sits next to the bot's, i.e. one level up — adjust if you deploy
# elsewhere). Refreshed daily by ../auto_token.py, which also restarts this service.
ACCESS_TOKEN_PATH=../.access_token

# Password for the dashboard's login page, and the secret used to sign session
# cookies. Generate a real random value for the second one, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
DASHBOARD_PASSWORD=choose_a_strong_password
DASHBOARD_SESSION_SECRET=random_long_string_for_signing_session_cookies

# Local port this process binds to (127.0.0.1 only — see ../Caddyfile for how it's
# exposed to the internet over HTTPS).
DASHBOARD_PORT=8765

[Unit]
Description=NIFTY Intraday Trade Decision Dashboard (advisory only — no order placement)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pnlmon
WorkingDirectory=/opt/nifty-decision-dashboard
ExecStart=/opt/nifty-decision-dashboard/venv/bin/python server.py
Restart=on-failure
RestartSec=30s
TimeoutStopSec=30

# Tighten security surface
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

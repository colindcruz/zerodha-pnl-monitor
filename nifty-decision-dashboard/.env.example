# server.py reads its own .env (place a real one at
# nifty-decision-dashboard/.env — python-dotenv loads it from the working directory).

# Same Kite app credentials as the main bot's .env — only the API key is needed here
# (this process reads the access token from ACCESS_TOKEN_PATH below, it doesn't do
# its own login).
KITE_API_KEY=your_api_key_here

# Path to the SAME .access_token file the trading bot writes (default assumes this
# directory sits next to the bot's, i.e. one level up — adjust if you deploy
# elsewhere). Refreshed daily by ../auto_token.py, which also restarts this service.
ACCESS_TOKEN_PATH=../.access_token

# Password for the dashboard's login page, and the secret used to sign session
# cookies. Deliberately prefixed DECISION_DASHBOARD_* (not DASHBOARD_*) to avoid
# any collision with live-dashboard/.env if both are ever loaded from the same
# process environment. Generate a real random value for the second one, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
DECISION_DASHBOARD_PASSWORD=choose_a_strong_password
DECISION_DASHBOARD_SESSION_SECRET=random_long_string_for_signing_session_cookies

# Local port this process binds to (127.0.0.1 only — see ../Caddyfile for how it's
# exposed to the internet over HTTPS, on its own nip.io subdomain).
DECISION_DASHBOARD_PORT=8766

# How often (seconds) the dashboard recomputes its engines and pushes a fresh state
# to connected browsers — independent of tick arrival rate, so a quiet market
# doesn't stall the UI.
RECOMPUTE_INTERVAL_SECONDS=15

# Paths to the OTHER systems' state files, read-only, purely so the Position panel
# can label which system already owns a given NIFTY position (strangle/hedge/
# long_option/manual). Defaults assume this directory sits next to theirs.
STRANGLE_STATE_FILE=../strangle_state.json
HEDGE_STATE_FILE=../hedge_state.json
LONG_OPTION_STATE_FILE=../long_option_state.json

# Where this service's own JSONL logs are written (see MANUAL.md section 12).
TICK_LOG_FILE=nifty_decision_tick_log.jsonl
TRADE_LOG_FILE=nifty_decision_trade_log.jsonl

# ── Kite Connect credentials ──────────────────────────────────────────────
# Get these from https://developers.kite.trade/ after creating an app
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here

# Written automatically by generate_token.py each morning.
# You can also set this manually if needed; the token file takes priority.
KITE_ACCESS_TOKEN=

# Path where generate_token.py writes (and pnl_monitor.py reads) the token.
# Default: .access_token (in the project directory)
ACCESS_TOKEN_PATH=.access_token

# Optional: for fully automated login (requires pyotp to be installed)
# KITE_USER_ID=your_zerodha_user_id
# KITE_PASSWORD=your_zerodha_password
# KITE_TOTP_SECRET=your_totp_base32_secret

# Redirect URL registered in your Kite app (only needed for automated login)
# KITE_REDIRECT_URL=https://127.0.0.1

# ── Telegram ──────────────────────────────────────────────────────────────
# Create a bot via @BotFather and get the token.
# Get your chat ID by messaging @userinfobot or https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ── P&L thresholds (in INR) ───────────────────────────────────────────────
LOSS_THRESHOLD=-5000
PROFIT_THRESHOLD=10000

# ── Poll settings ─────────────────────────────────────────────────────────
POLL_INTERVAL_MINUTES=5

# ── File paths (optional overrides) ──────────────────────────────────────
STATE_FILE=alert_state.json
LOG_FILE=pnl_monitor.log

# ── Desktop notifications via ntfy.sh ────────────────────────────────────
# Pick any unique topic name and open https://ntfy.sh/<your-topic> in your
# browser, click Allow — you'll get OS-level desktop flashes alongside Telegram.
NTFY_TOPIC=your-unique-topic-here

# ── WebSocket monitor extras (pnl_monitor.py in with-websockets/) ─────────
PERIODIC_INTERVAL_SECONDS=30
THRESHOLD_COOLDOWN_SECONDS=300
TRAIL_ACTIVATION_THRESHOLD=40000
TRAIL_PERCENT=20
EXIT_ALERT_REPEAT_SECONDS=15
TRAIL_CHECK_INTERVAL=1

# ---- Auto-exit on trailing breach ----
AUTO_EXIT=true                  # set to false to disable auto-exit (alerts only)
HEDGE_PRICE_THRESHOLD=5.0       # positions with LTP below this are never auto-exited
EXIT_BUFFER_SECONDS=30          # seconds below floor before orders are placed
PROFIT_TARGET=80000             # exit all non-hedge positions immediately when P&L hits this
LOSS_LIMIT=-40000               # exit all non-hedge positions immediately when P&L hits this

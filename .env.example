# ── Kite Connect credentials ──────────────────────────────────────────────
# Get these from https://developers.kite.trade/ after creating an app
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here

# Written automatically by generate_token.py / auto_token.py each morning.
# You can also set this manually if needed; the token file takes priority.
KITE_ACCESS_TOKEN=

# Path where generate_token.py writes (and pnl_monitor.py reads) the token.
# Default: .access_token (in the project directory)
ACCESS_TOKEN_PATH=.access_token

# Optional: for fully automated login (requires pyotp to be installed).
# Same three variables are required by auto_token.py's unattended daily cron run —
# leave them unset there and the 8:45am refresh will fail every morning.
# ZERODHA_USER_ID=your_zerodha_user_id
# ZERODHA_PASSWORD=your_zerodha_password
# ZERODHA_TOTP_SECRET=your_totp_base32_secret

# Redirect URL registered in your Kite app (only needed for automated login)
# KITE_REDIRECT_URL=https://127.0.0.1

# ── Telegram ──────────────────────────────────────────────────────────────
# Create a bot via @BotFather and get the token.
# Get your chat ID by messaging @userinfobot or https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ── Desktop notifications via ntfy.sh (optional) ───────────────────────────
# Pick any unique topic name and open https://ntfy.sh/<your-topic> in your
# browser, click Allow — you'll get OS-level desktop flashes alongside Telegram.
NTFY_TOPIC=your-unique-topic-here

# ── File paths (optional overrides) ────────────────────────────────────────
LOG_FILE=pnl_monitor.log
HISTORY_FILE=pnl_history.json

# ── VIX-adaptive ATR stop-loss (manual trades only, not the strangle) ──────
# multiplier = ATR_BASE_MULTIPLIER + (India_VIX - ATR_REFERENCE_VIX) * ATR_VIX_SENSITIVITY,
# clamped to [ATR_MIN_MULTIPLIER, ATR_MAX_MULTIPLIER]. Reasoning-based starting point,
# not backtested — validate against historical data before trusting with larger size.
ATR_BASE_MULTIPLIER=1.5
ATR_REFERENCE_VIX=15
ATR_VIX_SENSITIVITY=0.1
ATR_MIN_MULTIPLIER=1.5
ATR_MAX_MULTIPLIER=4.0

# ── Alert cadence / trailing profit-lock ───────────────────────────────────
MILESTONE_STEP=5000              # alert every time P&L crosses another multiple of this
TRAIL_ACTIVATION_THRESHOLD=40000  # arms the trailing profit-lock once P&L reaches this
EXIT_ALERT_REPEAT_SECONDS=15      # how often to repeat the "still below exit floor" alert
TRAIL_CHECK_INTERVAL=1            # main loop poll interval, in seconds
HEARTBEAT_INTERVAL_SECONDS=3600   # "still alive" alert interval when nothing else has fired

# ---- Green day floor ----
GREEN_DAY_ACTIVATION=20000       # arm the green-day floor once P&L hits this
GREEN_DAY_FLOOR=5000             # exit all non-hedge positions if P&L drops back to this

# ---- Auto-exit on trailing breach ----
AUTO_EXIT=true                  # set to false to disable auto-exit (alerts only)
HEDGE_PRICE_THRESHOLD=5.0       # positions with LTP below this are never auto-exited
EXIT_BUFFER_SECONDS=30          # seconds below floor before orders are placed
PROFIT_TARGET=80000             # exit all non-hedge positions immediately when P&L hits this
LOSS_WARNING_1=-20000           # warning alert only, no action taken
LOSS_WARNING_2=-30000           # warning alert only, no action taken
LOSS_LIMIT=-40000               # exit all non-hedge positions immediately when P&L hits this

# ---- Post-exit cool-off ----
COOLOFF_MINUTES=15              # after loss-limit/profit-target/trail-activation exit, auto-squareoff any new manual position for this long

# ---- Position size limit ----
MAX_POSITION_QTY=1950           # alert if any single non-hedge position's qty exceeds this

# ---- Greeks (/greeks command) ----
RISK_FREE_RATE=0.065            # used for Black-Scholes IV/Greeks calculations

# ---- NIFTY short strangle (auto) ----
STRANGLE_ENABLED=true                  # set to false to disable auto-entry entirely
STRANGLE_STRIKE_OFFSET=50              # 1-strike-OTM on NIFTY's 50-pt strikes
STRANGLE_SL_MULTIPLIER=2.0             # premium-multiple stop per leg; best combined return/drawdown across both backtested years, tune live via /set
STRANGLE_LOTS=5
STRANGLE_ENTRY_BUFFER_PCT=0.01         # aggressive-limit buffer off LTP for entry/exit fills
STRANGLE_ENTRY_RETRY_SECONDS=20        # retry cadence if entry order hasn't filled
STRANGLE_ENTRY_MAX_RETRIES=3           # give up (alert, no MARKET fallback) after this many retries
STRANGLE_STATE_FILE=strangle_state.json
